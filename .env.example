# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# --- Discord ---
# Discord Developer Portal -> Applications -> your app -> Bot -> Token
DISCORD_TOKEN=

# --- Spotify Web API (Client Credentials flow, for catalog search) ---
# https://developer.spotify.com/dashboard -> Create app -> Client ID / Client Secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Spotify Soloist WebSocket (local control connection) ---
# Always 127.0.0.1 here. If Soloist runs on another machine, forward it with
# an SSH tunnel (see docs/DEPLOYMENT.md) rather than pointing this at a
# remote address directly.
SOLOIST_WS_HOST=127.0.0.1
SOLOIST_WS_PORT=5710

# --- PulseAudio capture of Soloist's output ---
# Name of the null-sink's monitor source created by scripts/setup_pulse_sink.sh
SOLOIST_PULSE_MONITOR=soloist_out.monitor
# Leave unset to use the local Pulse socket. When the bot runs remotely,
# set this to tcp:127.0.0.1:<PULSE_PORT> forwarded over SSH from the machine
# running Soloist (see docs/DEPLOYMENT.md).
PULSE_SERVER=
